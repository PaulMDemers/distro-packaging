#!/bin/sh
set -eu

wallpaper="/usr/share/backgrounds/demuntu/demuntu-default.png"
icon_theme="DemSunset"
gtk_theme="DemSunset-Dark"
marco_theme="DemSunset-Dark"
log_dir="${XDG_CACHE_HOME:-$HOME/.cache}"
log_file="$log_dir/demsunset-mate-theme.log"

[ -f "$wallpaper" ] || exit 0
command -v gsettings >/dev/null 2>&1 || exit 0

mkdir -p "$log_dir" 2>/dev/null || true
exec >> "$log_file" 2>&1

echo "DemSunset MATE theme apply start: $(date -u +%Y-%m-%dT%H:%M:%SZ)"
echo "DISPLAY=${DISPLAY:-} DBUS_SESSION_BUS_ADDRESS=${DBUS_SESSION_BUS_ADDRESS:-}"

set_gsettings() {
  schema="$1"
  key="$2"
  value="$3"
  if gsettings writable "$schema" "$key" >/dev/null 2>&1; then
    gsettings set "$schema" "$key" "$value" >/dev/null 2>&1 || true
  fi
}

set_relocatable() {
  schema="$1"
  path="$2"
  key="$3"
  value="$4"
  gsettings set "$schema:$path" "$key" "$value" >/dev/null 2>&1 || true
}

panel_layout_ready() {
  ids="$(gsettings get org.mate.panel toplevel-id-list 2>/dev/null || printf '[]')"
  objects="$(gsettings get org.mate.panel object-id-list 2>/dev/null || printf '[]')"

  case "$ids" in
    *"'top'"*"'bottom'"*|*"'bottom'"*"'top'"*) ;;
    *) return 1 ;;
  esac

  case "$objects" in *"'menu-bar'"*) ;; *) return 1 ;; esac
  case "$objects" in *"'window-list'"*) ;; *) return 1 ;; esac
  case "$objects" in *"'volume-control'"*) ;; *) return 1 ;; esac
}

seed_mate_panels() {
  panel_layout_ready && return 0

  echo "Seeding Demuntu MATE panel layout"
  gsettings set org.mate.panel default-layout "'demuntu'" >/dev/null 2>&1 || true

  gsettings set org.mate.panel toplevel-id-list "['top','bottom']" >/dev/null 2>&1 || true
  gsettings set org.mate.panel object-id-list "['menu-bar','notification-area','volume-control','clock','show-desktop','window-list','workspace-switcher']" >/dev/null 2>&1 || true

  set_relocatable org.mate.panel.toplevel /org/mate/panel/toplevels/top/ name "'Top Panel'"
  set_relocatable org.mate.panel.toplevel /org/mate/panel/toplevels/top/ orientation "'top'"
  set_relocatable org.mate.panel.toplevel /org/mate/panel/toplevels/top/ expand true
  set_relocatable org.mate.panel.toplevel /org/mate/panel/toplevels/top/ size 28

  set_relocatable org.mate.panel.toplevel /org/mate/panel/toplevels/bottom/ name "'Bottom Panel'"
  set_relocatable org.mate.panel.toplevel /org/mate/panel/toplevels/bottom/ orientation "'bottom'"
  set_relocatable org.mate.panel.toplevel /org/mate/panel/toplevels/bottom/ expand true
  set_relocatable org.mate.panel.toplevel /org/mate/panel/toplevels/bottom/ size 28

  set_relocatable org.mate.panel.object /org/mate/panel/objects/menu-bar/ object-type "'menu-bar'"
  set_relocatable org.mate.panel.object /org/mate/panel/objects/menu-bar/ toplevel-id "'top'"
  set_relocatable org.mate.panel.object /org/mate/panel/objects/menu-bar/ position 0
  set_relocatable org.mate.panel.object /org/mate/panel/objects/menu-bar/ locked true

  set_relocatable org.mate.panel.object /org/mate/panel/objects/notification-area/ object-type "'applet'"
  set_relocatable org.mate.panel.object /org/mate/panel/objects/notification-area/ applet-iid "'NotificationAreaAppletFactory::NotificationArea'"
  set_relocatable org.mate.panel.object /org/mate/panel/objects/notification-area/ toplevel-id "'top'"
  set_relocatable org.mate.panel.object /org/mate/panel/objects/notification-area/ position 10
  set_relocatable org.mate.panel.object /org/mate/panel/objects/notification-area/ relative-to-edge "'end'"
  set_relocatable org.mate.panel.object /org/mate/panel/objects/notification-area/ locked true

  set_relocatable org.mate.panel.object /org/mate/panel/objects/volume-control/ object-type "'applet'"
  set_relocatable org.mate.panel.object /org/mate/panel/objects/volume-control/ applet-iid "'GvcAppletFactory::GvcApplet'"
  set_relocatable org.mate.panel.object /org/mate/panel/objects/volume-control/ toplevel-id "'top'"
  set_relocatable org.mate.panel.object /org/mate/panel/objects/volume-control/ position 20
  set_relocatable org.mate.panel.object /org/mate/panel/objects/volume-control/ relative-to-edge "'end'"
  set_relocatable org.mate.panel.object /org/mate/panel/objects/volume-control/ locked true

  set_relocatable org.mate.panel.object /org/mate/panel/objects/clock/ object-type "'applet'"
  set_relocatable org.mate.panel.object /org/mate/panel/objects/clock/ applet-iid "'ClockAppletFactory::ClockApplet'"
  set_relocatable org.mate.panel.object /org/mate/panel/objects/clock/ toplevel-id "'top'"
  set_relocatable org.mate.panel.object /org/mate/panel/objects/clock/ position 0
  set_relocatable org.mate.panel.object /org/mate/panel/objects/clock/ relative-to-edge "'end'"
  set_relocatable org.mate.panel.object /org/mate/panel/objects/clock/ locked true

  set_relocatable org.mate.panel.object /org/mate/panel/objects/show-desktop/ object-type "'applet'"
  set_relocatable org.mate.panel.object /org/mate/panel/objects/show-desktop/ applet-iid "'WnckletFactory::ShowDesktopApplet'"
  set_relocatable org.mate.panel.object /org/mate/panel/objects/show-desktop/ toplevel-id "'bottom'"
  set_relocatable org.mate.panel.object /org/mate/panel/objects/show-desktop/ position 0
  set_relocatable org.mate.panel.object /org/mate/panel/objects/show-desktop/ locked true

  set_relocatable org.mate.panel.object /org/mate/panel/objects/window-list/ object-type "'applet'"
  set_relocatable org.mate.panel.object /org/mate/panel/objects/window-list/ applet-iid "'WnckletFactory::WindowListApplet'"
  set_relocatable org.mate.panel.object /org/mate/panel/objects/window-list/ toplevel-id "'bottom'"
  set_relocatable org.mate.panel.object /org/mate/panel/objects/window-list/ position 20
  set_relocatable org.mate.panel.object /org/mate/panel/objects/window-list/ locked true

  set_relocatable org.mate.panel.object /org/mate/panel/objects/workspace-switcher/ object-type "'applet'"
  set_relocatable org.mate.panel.object /org/mate/panel/objects/workspace-switcher/ applet-iid "'WnckletFactory::WorkspaceSwitcherApplet'"
  set_relocatable org.mate.panel.object /org/mate/panel/objects/workspace-switcher/ toplevel-id "'bottom'"
  set_relocatable org.mate.panel.object /org/mate/panel/objects/workspace-switcher/ position 0
  set_relocatable org.mate.panel.object /org/mate/panel/objects/workspace-switcher/ relative-to-edge "'end'"
  set_relocatable org.mate.panel.object /org/mate/panel/objects/workspace-switcher/ locked true

  if command -v mate-panel >/dev/null 2>&1 && ! pgrep -u "$(id -u)" -x mate-panel >/dev/null 2>&1; then
    mate-panel >/dev/null 2>&1 &
    sleep 2
  fi
}

seed_mate_panels

set_gsettings org.mate.interface gtk-theme "'$gtk_theme'"
set_gsettings org.mate.interface icon-theme "'$icon_theme'"
set_gsettings org.mate.interface cursor-theme "'Adwaita'"
set_gsettings org.mate.interface font-name "'Sans 10'"
set_gsettings org.mate.interface document-font-name "'Sans 10'"
set_gsettings org.mate.interface monospace-font-name "'Monospace 10'"
set_gsettings org.mate.Marco.general theme "'$marco_theme'"
set_gsettings org.mate.background picture-filename "'$wallpaper'"
set_gsettings org.mate.background picture-options "'zoom'"
set_gsettings org.mate.background primary-color "'#1b1c22'"
set_gsettings org.mate.background secondary-color "'#ef7d35'"
set_gsettings org.mate.background color-shading-type "'vertical-gradient'"

for top in top bottom; do
  path="/org/mate/panel/toplevels/$top/"
  gsettings set "org.mate.panel.toplevel.background:${path}background/" type "'color'" >/dev/null 2>&1 || true
  gsettings set "org.mate.panel.toplevel.background:${path}background/" color "'#34343a'" >/dev/null 2>&1 || true
  gsettings set "org.mate.panel.toplevel.background:${path}background/" opacity 65535 >/dev/null 2>&1 || true
done

desktop_dir="$HOME/Desktop"
if [ -d "$desktop_dir" ]; then
  find "$desktop_dir" -maxdepth 1 -name '*.desktop' -exec chmod +x {} \; 2>/dev/null || true
fi

echo "DemSunset MATE theme apply done"
