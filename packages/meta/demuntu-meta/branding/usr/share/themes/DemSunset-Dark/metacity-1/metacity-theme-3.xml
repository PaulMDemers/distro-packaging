<?xml version="1.0"?>
<metacity_theme>
  <info>
    <name>DemSunset-Dark</name>
    <author>Demuntu Builder</author>
    <copyright>2026</copyright>
    <date>2026-06-05</date>
    <description>Charcoal MATE window borders with sunset highlights.</description>
  </info>
  <frame_geometry name="normal" rounded_top_left="false" rounded_top_right="false" title_scale="medium">
    <distance name="left_width" value="5"/>
    <distance name="right_width" value="5"/>
    <distance name="bottom_height" value="5"/>
    <distance name="left_titlebar_edge" value="6"/>
    <distance name="right_titlebar_edge" value="6"/>
    <distance name="title_vertical_pad" value="8"/>
    <distance name="button_width" value="18"/>
    <distance name="button_height" value="18"/>
    <border name="title_border" left="8" right="8" top="4" bottom="4"/>
    <border name="button_border" left="2" right="2" top="2" bottom="2"/>
  </frame_geometry>
  <draw_ops name="titlebar_focused">
    <gradient type="vertical" x="0" y="0" width="width" height="height">
      <color value="#4a454a"/>
      <color value="#313137"/>
    </gradient>
    <line color="#ef7a34" x1="0" y1="height-2" x2="width" y2="height-2"/>
    <line color="#ec5c86" x1="0" y1="height-1" x2="width" y2="height-1"/>
  </draw_ops>
  <draw_ops name="titlebar_unfocused">
    <gradient type="vertical" x="0" y="0" width="width" height="height">
      <color value="#3d3d43"/>
      <color value="#2d2d33"/>
    </gradient>
    <line color="#595960" x1="0" y1="height-1" x2="width" y2="height-1"/>
  </draw_ops>
  <draw_ops name="title_focused">
    <title color="#f3f0ef" x="(width-title_width)/2" y="((height-title_height)/2)"/>
  </draw_ops>
  <draw_ops name="title_unfocused">
    <title color="#bbb8b8" x="(width-title_width)/2" y="((height-title_height)/2)"/>
  </draw_ops>
  <draw_ops name="button_prelight">
    <rectangle color="#f1c1ad" filled="true" x="1" y="1" width="width-2" height="height-2"/>
  </draw_ops>
  <draw_ops name="button_pressed">
    <rectangle color="#ec5c86" filled="true" x="1" y="1" width="width-2" height="height-2"/>
  </draw_ops>
  <draw_ops name="minimize_icon">
    <line color="#f2f0ef" x1="ButtonIPad" y1="height-ButtonIPad-1" x2="width-ButtonIPad" y2="height-ButtonIPad-1" width="2"/>
  </draw_ops>
  <draw_ops name="minimize_prelight">
    <rectangle color="#f1c1ad" filled="true" x="1" y="1" width="width-2" height="height-2"/>
    <line color="#f2f0ef" x1="ButtonIPad" y1="height-ButtonIPad-1" x2="width-ButtonIPad" y2="height-ButtonIPad-1" width="2"/>
  </draw_ops>
  <draw_ops name="minimize_pressed">
    <rectangle color="#ec5c86" filled="true" x="1" y="1" width="width-2" height="height-2"/>
    <line color="#f2f0ef" x1="ButtonIPad" y1="height-ButtonIPad-1" x2="width-ButtonIPad" y2="height-ButtonIPad-1" width="2"/>
  </draw_ops>
  <draw_ops name="maximize_icon">
    <rectangle color="#f2f0ef" filled="true" x="ButtonIPad" y="ButtonIPad" width="width-ButtonIPad*2-1" height="height-ButtonIPad*2-1"/>
  </draw_ops>
  <draw_ops name="maximize_prelight">
    <rectangle color="#f1c1ad" filled="true" x="1" y="1" width="width-2" height="height-2"/>
    <rectangle color="#f2f0ef" filled="true" x="ButtonIPad" y="ButtonIPad" width="width-ButtonIPad*2-1" height="height-ButtonIPad*2-1"/>
  </draw_ops>
  <draw_ops name="maximize_pressed">
    <rectangle color="#ec5c86" filled="true" x="1" y="1" width="width-2" height="height-2"/>
    <rectangle color="#f2f0ef" filled="true" x="ButtonIPad" y="ButtonIPad" width="width-ButtonIPad*2-1" height="height-ButtonIPad*2-1"/>
  </draw_ops>
  <draw_ops name="restore_icon">
    <rectangle color="#f2f0ef" filled="true" x="ButtonIPad+3" y="ButtonIPad" width="width-ButtonIPad*2-4" height="height-ButtonIPad*2-4"/>
    <rectangle color="#f2f0ef" filled="true" x="ButtonIPad" y="ButtonIPad+3" width="width-ButtonIPad*2-4" height="height-ButtonIPad*2-4"/>
  </draw_ops>
  <draw_ops name="restore_prelight">
    <rectangle color="#f1c1ad" filled="true" x="1" y="1" width="width-2" height="height-2"/>
    <rectangle color="#f2f0ef" filled="true" x="ButtonIPad+3" y="ButtonIPad" width="width-ButtonIPad*2-4" height="height-ButtonIPad*2-4"/>
    <rectangle color="#f2f0ef" filled="true" x="ButtonIPad" y="ButtonIPad+3" width="width-ButtonIPad*2-4" height="height-ButtonIPad*2-4"/>
  </draw_ops>
  <draw_ops name="restore_pressed">
    <rectangle color="#ec5c86" filled="true" x="1" y="1" width="width-2" height="height-2"/>
    <rectangle color="#f2f0ef" filled="true" x="ButtonIPad+3" y="ButtonIPad" width="width-ButtonIPad*2-4" height="height-ButtonIPad*2-4"/>
    <rectangle color="#f2f0ef" filled="true" x="ButtonIPad" y="ButtonIPad+3" width="width-ButtonIPad*2-4" height="height-ButtonIPad*2-4"/>
  </draw_ops>
  <draw_ops name="close_icon">
    <line color="#f2f0ef" x1="ButtonIPad" y1="ButtonIPad" x2="width-ButtonIPad" y2="height-ButtonIPad" width="2"/>
    <line color="#f2f0ef" x1="ButtonIPad" y1="height-ButtonIPad" x2="width-ButtonIPad" y2="ButtonIPad" width="2"/>
  </draw_ops>
  <draw_ops name="close_prelight">
    <rectangle color="#f1c1ad" filled="true" x="1" y="1" width="width-2" height="height-2"/>
    <line color="#f2f0ef" x1="ButtonIPad" y1="ButtonIPad" x2="width-ButtonIPad" y2="height-ButtonIPad" width="2"/>
    <line color="#f2f0ef" x1="ButtonIPad" y1="height-ButtonIPad" x2="width-ButtonIPad" y2="ButtonIPad" width="2"/>
  </draw_ops>
  <draw_ops name="close_pressed">
    <rectangle color="#ec5c86" filled="true" x="1" y="1" width="width-2" height="height-2"/>
    <line color="#f2f0ef" x1="ButtonIPad" y1="ButtonIPad" x2="width-ButtonIPad" y2="height-ButtonIPad" width="2"/>
    <line color="#f2f0ef" x1="ButtonIPad" y1="height-ButtonIPad" x2="width-ButtonIPad" y2="ButtonIPad" width="2"/>
  </draw_ops>
  <frame_style name="normal_focused" geometry="normal">
    <piece position="entire_background" draw_ops="titlebar_focused"/>
    <piece position="title" draw_ops="title_focused"/>
    <button function="minimize" state="normal" draw_ops="minimize_icon"/>
    <button function="minimize" state="prelight" draw_ops="minimize_prelight"/>
    <button function="minimize" state="pressed" draw_ops="minimize_pressed"/>
    <button function="maximize" state="normal" draw_ops="maximize_icon"/>
    <button function="maximize" state="prelight" draw_ops="maximize_prelight"/>
    <button function="maximize" state="pressed" draw_ops="maximize_pressed"/>
    <button function="close" state="normal" draw_ops="close_icon"/>
    <button function="close" state="prelight" draw_ops="close_prelight"/>
    <button function="close" state="pressed" draw_ops="close_pressed"/>
  </frame_style>
  <frame_style name="normal_unfocused" geometry="normal">
    <piece position="entire_background" draw_ops="titlebar_unfocused"/>
    <piece position="title" draw_ops="title_unfocused"/>
  </frame_style>
  <frame_style_set name="normal">
    <frame focus="yes" state="normal" resize="both" style="normal_focused"/>
    <frame focus="no" state="normal" resize="both" style="normal_unfocused"/>
  </frame_style_set>
  <window type="normal" style_set="normal"/>
  <window type="dialog" style_set="normal"/>
</metacity_theme>
