<?xml version="1.0"?>
<metacity_theme>
  <info>
    <name>DemSunset-Dark</name>
    <author>Demuntu Builder</author>
    <copyright>2026</copyright>
    <date>2026-06-05</date>
    <description>Charcoal MATE window borders with sunset highlights.</description>
  </info>
  <frame_geometry name="normal" rounded_top_left="false" rounded_top_right="false" title_scale="medium">
    <distance name="left_width" value="5"/>
    <distance name="right_width" value="5"/>
    <distance name="bottom_height" value="5"/>
    <distance name="left_titlebar_edge" value="6"/>
    <distance name="right_titlebar_edge" value="6"/>
    <distance name="title_vertical_pad" value="8"/>
    <border name="title_border" left="8" right="8" top="4" bottom="4"/>
    <border name="button_border" left="2" right="2" top="2" bottom="2"/>
  </frame_geometry>
  <draw_ops name="titlebar_focused">
    <gradient type="vertical" x="0" y="0" width="width" height="height">
      <color value="#4a454a"/>
      <color value="#313137"/>
    </gradient>
    <line color="#ef7a34" x1="0" y1="height-2" x2="width" y2="height-2"/>
    <line color="#ec5c86" x1="0" y1="height-1" x2="width" y2="height-1"/>
  </draw_ops>
  <draw_ops name="titlebar_unfocused">
    <gradient type="vertical" x="0" y="0" width="width" height="height">
      <color value="#3d3d43"/>
      <color value="#2d2d33"/>
    </gradient>
    <line color="#595960" x1="0" y1="height-1" x2="width" y2="height-1"/>
  </draw_ops>
  <draw_ops name="title_focused">
    <title color="#f3f0ef" x="(width-title_width)/2" y="((height-title_height)/2)"/>
  </draw_ops>
  <draw_ops name="title_unfocused">
    <title color="#bbb8b8" x="(width-title_width)/2" y="((height-title_height)/2)"/>
  </draw_ops>
  <draw_ops name="button_bg">
    <rectangle color="#3b3b42" filled="true" x="0" y="0" width="width" height="height"/>
  </draw_ops>
  <draw_ops name="close_icon">
    <line color="#f2f0ef" x1="ButtonIPad" y1="ButtonIPad" x2="width-ButtonIPad" y2="height-ButtonIPad"/>
    <line color="#f2f0ef" x1="ButtonIPad" y1="height-ButtonIPad" x2="width-ButtonIPad" y2="ButtonIPad"/>
  </draw_ops>
  <frame_style name="normal_focused" geometry="normal">
    <piece position="entire_background" draw_ops="titlebar_focused"/>
    <piece position="title" draw_ops="title_focused"/>
    <button function="close" state="normal" draw_ops="button_bg"/>
    <button function="close" state="normal" draw_ops="close_icon"/>
  </frame_style>
  <frame_style name="normal_unfocused" geometry="normal">
    <piece position="entire_background" draw_ops="titlebar_unfocused"/>
    <piece position="title" draw_ops="title_unfocused"/>
  </frame_style>
  <frame_style_set name="normal">
    <frame focus="yes" state="normal" resize="both" style="normal_focused"/>
    <frame focus="no" state="normal" resize="both" style="normal_unfocused"/>
  </frame_style_set>
  <window type="normal" style_set="normal"/>
  <window type="dialog" style_set="normal"/>
</metacity_theme>
