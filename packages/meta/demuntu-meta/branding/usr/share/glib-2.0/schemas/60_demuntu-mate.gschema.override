[org.mate.panel]
default-layout='demuntu'

[org.mate.panel.menubar]
icon-name='distributor-logo-demuntu'

[org.mate.background]
picture-filename='/usr/share/backgrounds/demuntu/demuntu-default.png'
picture-options='zoom'
primary-color='#1b1c22'
secondary-color='#ef7d35'
color-shading-type='vertical-gradient'

[org.mate.interface]
gtk-theme='DemSunset-Dark'
icon-theme='DemSunset'

[org.mate.Marco.general]
theme='DemSunset-Dark'
