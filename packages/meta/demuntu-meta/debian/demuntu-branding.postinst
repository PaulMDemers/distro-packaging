#!/bin/sh
set -e

if [ "$1" = "configure" ]; then
  if [ -f /usr/lib/demuntu/os-release ]; then
    cp /usr/lib/demuntu/os-release /etc/os-release
  fi

  if [ -f /usr/lib/demuntu/issue ]; then
    cp /usr/lib/demuntu/issue /etc/issue
  fi

  if [ -f /usr/lib/demuntu/motd ]; then
    cp /usr/lib/demuntu/motd /etc/motd
  fi

  if command -v gtk-update-icon-cache >/dev/null 2>&1; then
    gtk-update-icon-cache -q -t -f /usr/share/icons/DemChrome || true
  fi

  chmod 0755 /usr/bin/demuntu-welcome 2>/dev/null || true
  chmod 0755 /usr/lib/demuntu/apply-xfce-theme 2>/dev/null || true
  chmod 0755 /usr/lib/demuntu/demuntu-welcome 2>/dev/null || true
  chmod 0755 /etc/skel/Desktop/Demuntu\ Welcome.desktop 2>/dev/null || true
  find /usr/lib/demuntu/package-sets -type f -name '*.sh' -exec chmod 0755 {} \; 2>/dev/null || true

  if [ -f /etc/xdg/menus/xfce-applications.menu ]; then
    sed -i \
      -e '/<Filename>xfce4-terminal-emulator\.desktop<\/Filename>/d' \
      -e '/<Filename>xfce4-file-manager\.desktop<\/Filename>/d' \
      -e '/<Filename>xfce4-mail-reader\.desktop<\/Filename>/d' \
      -e '/<Filename>xfce4-web-browser\.desktop<\/Filename>/d' \
      /etc/xdg/menus/xfce-applications.menu
  fi

  if [ -d /usr/share/demuntu/application-overrides ]; then
    install -d -m 0755 /usr/local/share/applications
    cp /usr/share/demuntu/application-overrides/*.desktop /usr/local/share/applications/ 2>/dev/null || true
  fi

  if command -v update-alternatives >/dev/null 2>&1 && \
    [ -f /usr/share/plymouth/themes/demuntu-chrome/demuntu-chrome.plymouth ]; then
    update-alternatives --install \
      /usr/share/plymouth/themes/default.plymouth \
      default.plymouth \
      /usr/share/plymouth/themes/demuntu-chrome/demuntu-chrome.plymouth \
      90 >/dev/null 2>&1 || true
  fi

  printf '0.1\n' > /etc/demuntu-release
fi

#DEBHELPER#
