#!/bin/sh
set -eu

cat > /etc/motd <<'EOF'
Welcome to Demian Server.
EOF

cat > /etc/systemd/system/custom-boot-marker.service <<'EOF'
[Unit]
Description=Demian server boot marker
After=serial-getty@ttyS0.service

[Service]
Type=oneshot
ExecStart=/bin/sh -c 'printf "\nDEMIAN_SERVER_READY\n" > /dev/ttyS0'

[Install]
WantedBy=multi-user.target
EOF

mkdir -p /etc/systemd/system/getty.target.wants
ln -sf /lib/systemd/system/serial-getty@.service \
  /etc/systemd/system/getty.target.wants/serial-getty@ttyS0.service

mkdir -p /etc/systemd/system/multi-user.target.wants
ln -sf /etc/systemd/system/custom-boot-marker.service \
  /etc/systemd/system/multi-user.target.wants/custom-boot-marker.service
