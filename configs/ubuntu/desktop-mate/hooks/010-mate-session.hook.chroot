#!/usr/bin/env bash
set -euo pipefail

if command -v plymouth-set-default-theme >/dev/null 2>&1; then
  plymouth-set-default-theme demuntu-sunset || true
fi

mkdir -p /etc/lightdm/lightdm.conf.d
cat > /etc/lightdm/lightdm.conf.d/50-demuntu-autologin.conf <<'EOF'
[Seat:*]
autologin-user=ubuntu
autologin-user-timeout=0
user-session=mate
greeter-session=lightdm-gtk-greeter
EOF

printf '%s\n' /usr/sbin/lightdm > /etc/X11/default-display-manager
rm -f /etc/systemd/system/display-manager.service
ln -s /usr/lib/systemd/system/lightdm.service /etc/systemd/system/display-manager.service
mkdir -p /etc/systemd/system/graphical.target.wants
ln -sfn /etc/systemd/system/display-manager.service \
  /etc/systemd/system/graphical.target.wants/display-manager.service
systemctl disable gdm3.service gdm.service || true

for launcher in /usr/share/applications/ubiquity.desktop /usr/share/applications/*installer*.desktop; do
  [ -f "$launcher" ] || continue
  if grep -qiE 'ubiquity|installer|install' "$launcher"; then
    sed -i \
      -e 's/^Name=.*/Name=Install Demuntu/' \
      -e 's/^Name\[en_US\]=.*/Name[en_US]=Install Demuntu/' \
      -e 's/^Icon=.*/Icon=distributor-logo-demuntu/' \
      "$launcher"
  fi
done

if [ -d /usr/share/demuntu/compizconfig ]; then
  mkdir -p /etc/compizconfig
  cp /usr/share/demuntu/compizconfig/mate.conf /etc/compizconfig/mate.conf
  cp /usr/share/demuntu/compizconfig/mate.ini /etc/compizconfig/mate.ini
fi

mkdir -p /etc/skel/.config/autostart /usr/local/bin
cat > /usr/local/bin/demuntu-compiz-start <<'EOF'
#!/bin/sh

log=/tmp/demuntu-compiz-autostart.log
exec >>"$log" 2>&1

echo "DEMUNTU_COMPIZ_AUTOSTART_BEGIN"
date

if ! command -v compiz >/dev/null 2>&1; then
  echo "DEMUNTU_COMPIZ_FALLBACK missing compiz"
  exec marco --replace
fi

if ! command -v glxinfo >/dev/null 2>&1 || ! timeout 10 glxinfo >/dev/null 2>&1; then
  echo "DEMUNTU_COMPIZ_FALLBACK glxinfo failed"
  exec marco --replace
fi

sleep 3
echo "DEMUNTU_COMPIZ_REPLACE_BEGIN"
exec compiz --replace ccp
EOF
chmod 0755 /usr/local/bin/demuntu-compiz-start

cat > /etc/skel/.config/autostart/demuntu-compiz.desktop <<'EOF'
[Desktop Entry]
Type=Application
Name=Demuntu Compiz
Exec=/usr/local/bin/demuntu-compiz-start
OnlyShowIn=MATE;
X-MATE-Autostart-enabled=true
NoDisplay=true
EOF

mkdir -p /etc/xdg/autostart
cp /etc/skel/.config/autostart/demuntu-compiz.desktop /etc/xdg/autostart/

if [ -x /usr/lib/demuntu/apply-mate-theme ]; then
  mkdir -p /etc/skel/.config/autostart
  cp /etc/xdg/autostart/demsunset-mate-theme.desktop \
    /etc/skel/.config/autostart/demsunset-mate-theme.desktop 2>/dev/null || true
fi

if command -v glib-compile-schemas >/dev/null 2>&1; then
  glib-compile-schemas /usr/share/glib-2.0/schemas || true
fi

rm -f /var/crash/* || true
if [ -f /etc/default/apport ]; then
  sed -i 's/^enabled=.*/enabled=0/' /etc/default/apport
fi
systemctl disable \
  apport.service \
  apport-autoreport.path \
  apport-autoreport.timer \
  whoopsie.path || true
